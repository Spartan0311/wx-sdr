# /opt/wx-sdr/wx.env — chmod 600, never commit the real one (carries the API key)
#
# Every key is OPTIONAL except MESHTOC_API_KEY (empty = dry-run). Each entry
# notes the code default in same_bridge.py so you can see what you are
# overriding. Keys marked SITE are specific to one installation and will NOT
# work unmodified anywhere else — read those before starting the service.

# ---------------------------------------------------------------------------
# MeshTOC sink
# ---------------------------------------------------------------------------
MESHTOC_URL=http://127.0.0.1:5070
# Write-scoped MeshTOC API key. Empty = dry-run (bridge prints instead of sending).
MESHTOC_API_KEY=
# SITE. Mesh channel index for alerts — pick the channel your mesh actually
# uses for weather traffic.                                        default: 4
WX_CHANNEL=2

# ---------------------------------------------------------------------------
# Radio
# ---------------------------------------------------------------------------
# SITE. NWR transmitter frequency. This one is KEC94 Phoenix / South Mountain;
# find your local transmitter at weather.gov/nwr.           default: 162.550M
WX_FREQ=162.550M
# Tuner gain in dB.                                                default: 30
WX_GAIN=30
# SITE. RTL-SDR EEPROM serial to bind to, so a second dongle on the same host
# cannot shift device indexes underneath us. THIS VALUE IS THE AUTHOR'S DONGLE
# and is also the code default — find yours with: rtl_eeprom -d 0
# A wrong value is not silent. The service logs
#   [radio] dongle serial <x> not found — exiting for systemd restart
# and systemd restart-loops.                                default: 66666666
WX_SERIAL=66666666

# ---------------------------------------------------------------------------
# Alert filtering
# ---------------------------------------------------------------------------
# Comma list of SSCCC county FIPS to alert on (e.g. 04013,04021). Empty = all.
WX_FIPS=
# SAME event codes that get the "🔴 WX ALERT" label prefix (label ONLY — bells
# were removed 2026-07-21; nothing this service sends ever rings a device).
# LEAVE UNSET: the default is every warning-class code, which is the intended
# configuration. Set only to deliberately narrow the loud tier.
WX_ALERT_CODES=

# ---------------------------------------------------------------------------
# Voice enrichment  (tier 2 — needs faster-whisper + Ollama, ~6 GB on disk)
# ---------------------------------------------------------------------------
# Record after the SAME header -> whisper -> Ollama -> "WX DETAIL" follow-up.
# Set 0 for the tier-1 build (SAME header -> mesh only), which is the
# life-safety path and runs on Pi-class hardware.                  default: 1
WX_VOICE=1
# Hard cap on a single recording. Normal messages end on the SAME EOM well
# before this; the cap only bounds a transmitter that never sends one.
WX_VOICE_MAX_SECS=150
# RECOMMENDED small.en (~500 MB int8). The code default is base — smaller and
# faster — but the hotword priming and CORRECTIONS tuning in same_bridge.py
# were measured against small.en, and that is the configuration the published
# transcription figures describe.                               default: base
WHISPER_MODEL=small.en
OLLAMA_URL=http://127.0.0.1:11434
# RECOMMENDED qwen2.5:7b, which produces the summaries the published figures
# describe. The code default qwen2.5:3b works and is the cheaper tier-2 option.
#                                                         default: qwen2.5:3b
OLLAMA_MODEL=qwen2.5:7b

# ---------------------------------------------------------------------------
# Periodic conditions posts
# ---------------------------------------------------------------------------
# Capture the routine broadcast every N hours off the live tap (no decode
# blackout), summarize, send as "WX COND:". 0 = off.               default: 0
WX_COND_EVERY_H=3
# SITE. Channel for the conditions lane. Independent of WX_CHANNEL: at the
# reference installation the alert lane sits on the community channel while
# the conditions lane is still on a test channel being evaluated.  default: 4
WX_COND_CHANNEL=4

# ---------------------------------------------------------------------------
# Decoder
# ---------------------------------------------------------------------------
# samedec (a Rust binary expected at /opt/wx-sdr/bin/samedec) or multimon for
# the legacy multimon-ng path. samedec is the default and is what the published
# figures use.                                               default: samedec
#WX_DECODER=samedec

# ---------------------------------------------------------------------------
# Recordings
# ---------------------------------------------------------------------------
# Where voice captures land, and the bound on that directory. Eviction is
# OLDEST-FIRST by FILE COUNT and TOTAL SIZE — there is no age-based expiry, so
# a quiet month keeps old files indefinitely while a busy week evicts within
# days. 150 s at 22050 Hz/16-bit mono is ~6.6 MB, so both caps land near 2 GB.
#WX_RECORDINGS_DIR=/opt/wx-sdr/recordings
#WX_REC_MAX_FILES=300
#WX_REC_MAX_MB=2048

# ---------------------------------------------------------------------------
# Control / live-listen server
# ---------------------------------------------------------------------------
# Local HTTP control surface (status, live listen, RF sweep) that the MeshTOC
# WXSDR page talks to. The bind stays on loopback: it is unauthenticated by
# design and is reached only from the same host.
#WX_CTRL_HOST=127.0.0.1
#WX_CTRL_PORT=5071
# Concurrent live-listen clients. One is deliberate — each listener pins a
# server thread, and a second slot only ever served a stale session that had
# not released yet.                                                default: 1
#WX_MAX_LISTENERS=1

# ---------------------------------------------------------------------------
# Receiver tuning (experimental). EVERY key below defaults to the GOLD baseline
# in same_bridge.py — leaving them unset/absent reproduces the known-good
# receiver exactly. Gold = the config measuring 16.4 dB over floor on
# 2026-07-18 after the attic connector swap.
#
# The reference installation runs NON-GOLD values (WX_FIR=9, WX_DC=0,
# WX_PPM=-3) arrived at by MEASURING at that site. They are not defaults to
# copy — your RF environment is not ours. Start unset and measure your own.
#
# Measure the effect of a change, don't guess:
#   WX_GAIN  -> RF domain. Use the WXSDR page's RF sweep (watch floor_db).
#   WX_FIR / WX_DC -> AUDIO domain. rtl_power never runs rtl_fm's audio chain,
#                     so the sweep CANNOT see these. Watch quieting_db instead.
# ---------------------------------------------------------------------------

# Low-leakage downsample filter. "9" or empty (off). rtl_fm's own help says the
# default (off) "has bad roll off" — we downsample ~1 MHz to 22050 Hz with no
# filter, so out-of-band energy aliases into the audio band. That is exactly how
# broadband hash from nearby electronics becomes audible hiss. Best first try.
#WX_FIR=9

# DC blocking filter (-E dc). The R828D is zero-IF so it has a centre-frequency
# DC spike by design. SAME tones are at 1562.5/2083.3 Hz, far from DC.
#WX_DC=1

# Tuner frequency error correction in ppm. If the dongle is off-frequency the
# signal sits off-centre in the filter and reception degrades. Measure first.
#WX_PPM=0

# ⚠ De-emphasis (-E deemp). LEAVE THIS OFF for the decode path. 75 us
# de-emphasis corners at ~2.1 kHz, right on SAME's SPACE tone (2083.3 Hz), while
# barely touching MARK (1562.5 Hz) — it skews the exact tone balance the decoder
# depends on, trading alert reliability for listening comfort. For nicer audio,
# filter the listener tee instead and leave the decoder's stream raw.
#WX_DEEMP=0

# Zone for the human-readable times in SAME alert broadcasts (issue + expiry).
# Unset = America/Phoenix. This bridge runs under its own systemd unit, so —
# unlike the MeshTOC default-scripts — it does NOT receive the runner-injected
# TZ from the operator's "Schedule timezone" setting.
#
# ⚠ SET THIS if you are outside Arizona. The resolver falls back
#   TZ -> America/Phoenix -> UTC
# and Arizona does not observe DST, so an unset TZ elsewhere yields
# confidently wrong broadcast times for half the year rather than an error.
#TZ=America/Phoenix
